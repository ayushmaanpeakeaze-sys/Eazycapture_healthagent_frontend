# Production build (Vercel). The API is reached same-origin through the
# vercel.json rewrites (/api/* -> Railway backend), so these are RELATIVE paths
# — no CORS, and the SSE progress stream works unchanged.
#
# VITE_API_URL is intentionally left unset (defaults to ""), so apiClient also
# uses relative /api/* and goes through the same proxy.
VITE_HEALTHCHECK_API_BASE=/api/v1/health
