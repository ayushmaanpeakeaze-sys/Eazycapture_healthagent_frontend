{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://eazycapture-api-production.up.railway.app/api/$1"
    },
    {
      "source": "/accounting/(.*)",
      "destination": "https://eazycapture-api-production.up.railway.app/accounting/$1"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
